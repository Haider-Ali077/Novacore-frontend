# SuperNova frontend settings. Copy to .env.local (git-ignored).

# Where the SuperNova backend runs. Every /api/... request of the page is forwarded there.
BACKEND_URL=http://localhost:3001

# Optional: 1 shows the TS and the technical steps (otherwise ?technical=1 in the address turns them on).
NEXT_PUBLIC_SHOW_TECHNICAL_STEPS=
